# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / NEXT_PUBLIC_APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="https://example.com"

# DATABASE_URL: Pooled PostgreSQL connection for Prisma Client at runtime.
# For Neon, use the hostname with "-pooler" (e.g. ep-xxx-pooler.region.aws.neon.tech).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aifind?sslmode=require"

# DIRECT_URL: Direct PostgreSQL connection for Prisma CLI (migrate, db push, seed).
# For Neon, use the non-pooler hostname (e.g. ep-xxx.region.aws.neon.tech).
# For local Postgres, this can match DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aifind?sslmode=require"

# ADMIN AUTHENTICATION — Required for /admin access and write APIs.
# CHANGE THESE VALUES BEFORE DEPLOYING TO PRODUCTION.
# ADMIN_AUTH_SECRET: long random secret (>= 32 chars) used to sign session cookies.
ADMIN_AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-characters"
# ADMIN_USERNAME: Admin sign-in username (default "admin").
ADMIN_USERNAME="admin"
# ADMIN_PASSWORD: Plaintext admin password (or prefixed with sha256: for hash).
ADMIN_PASSWORD="admin123"

# TOOL MONITORING — Website health checks & verification freshness thresholds.
MONITORING_REQUEST_TIMEOUT_MS=10000
MONITORING_MAX_REDIRECTS=5
MONITORING_MAX_BATCH_SIZE=25
VERIFICATION_STALE_DAYS=90
VERIFICATION_WARNING_DAYS=60
VERIFICATION_HIGH_PRIORITY_DAYS=180
