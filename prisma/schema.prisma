// Prisma Schema for AIFind Platform
// Supports 10,000+ AI Tools, Categories, Personas, Comparisons, Reviews, Articles, and FAQs

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PricingModel {
  Free
  Freemium
  Paid
}

model Category {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  iconName        String
  description     String   @db.Text
  longDescription String   @db.Text
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tools           Tool[]
  faqs            CategoryFAQ[]
}

model Tool {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  logo         String
  tagline      String
  description  String       @db.Text
  categoryId   String
  categoryName String
  pricingModel PricingModel @default(Freemium)
  monthlyPrice Float?
  hasFreeTrial Boolean      @default(true)
  websiteUrl   String
  rating       Float        @default(4.5)
  reviewCount  Int          @default(0)
  verified     Boolean      @default(true)
  featured     Boolean      @default(false)
  trending     Boolean      @default(false)
  hasApi       Boolean      @default(false)
  hasMobileApp Boolean      @default(false)
  hasExtension Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relationships
  category     Category     @relation(fields: [categoryId], references: [id])
  tags         ToolTag[]
  features     ToolFeature[]
  pros         ToolPro[]
  cons         ToolCon[]
  screenshots  ToolScreenshot[]
  reviews      Review[]
  targetUsers  ToolPersona[]
  faqs         ToolFAQ[]
  
  // Self-referential alternatives
  alternativesFrom ToolAlternative[] @relation("ToolAlternativeSource")
  alternativesTo   ToolAlternative[] @relation("ToolAlternativeTarget")

  // Comparisons
  comparisonsAs1 Comparison[] @relation("Tool1Comparisons")
  comparisonsAs2 Comparison[] @relation("Tool2Comparisons")
}

model ToolTag {
  id     String @id @default(cuid())
  toolId String
  tag    String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([tag])
}

model ToolFeature {
  id          String  @id @default(cuid())
  toolId      String
  title       String
  description String?
  tool        Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model ToolPro {
  id     String @id @default(cuid())
  toolId String
  text   String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model ToolCon {
  id     String @id @default(cuid())
  toolId String
  text   String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model ToolScreenshot {
  id     String @id @default(cuid())
  toolId String
  url    String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model ToolAlternative {
  id            String @id @default(cuid())
  sourceToolId  String
  targetToolId  String
  sourceTool    Tool   @relation("ToolAlternativeSource", fields: [sourceToolId], references: [id], onDelete: Cascade)
  targetTool    Tool   @relation("ToolAlternativeTarget", fields: [targetToolId], references: [id], onDelete: Cascade)

  @@unique([sourceToolId, targetToolId])
}

model Persona {
  id           String   @id @default(cuid())
  title        String   @unique
  slug         String   @unique
  iconName     String
  subtitle     String
  description  String   @db.Text
  targetRole   String
  keyBenefits  String[]
  topToolSlugs String[]
  createdAt    DateTime @default(now())

  tools        ToolPersona[]
  faqs         PersonaFAQ[]
}

model ToolPersona {
  id        String  @id @default(cuid())
  toolId    String
  personaId String
  tool      Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([toolId, personaId])
}

model Review {
  id           String   @id @default(cuid())
  toolSlug     String
  authorName   String
  authorRole   String
  rating       Int
  comment      String   @db.Text
  date         String
  verifiedUser Boolean  @default(true)
  createdAt    DateTime @default(now())

  tool         Tool     @relation(fields: [toolSlug], references: [slug], onDelete: Cascade)
}

model Comparison {
  id        String   @id @default(cuid())
  slug      String   @unique
  tool1Slug String
  tool2Slug String
  title     String
  overview  String   @db.Text
  bestFor1  String
  bestFor2  String
  verdict   String   @db.Text
  winnerSlug String
  createdAt DateTime @default(now())

  tool1     Tool     @relation("Tool1Comparisons", fields: [tool1Slug], references: [slug])
  tool2     Tool     @relation("Tool2Comparisons", fields: [tool2Slug], references: [slug])
  features  ComparisonFeature[]
}

model ComparisonFeature {
  id           String     @id @default(cuid())
  comparisonId String
  feature      String
  tool1Value   String
  tool2Value   String
  winnerSlug   String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
}

model CategoryFAQ {
  id         String   @id @default(cuid())
  categoryId String
  question   String
  answer     String   @db.Text
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model PersonaFAQ {
  id        String  @id @default(cuid())
  personaId String
  question  String
  answer    String  @db.Text
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

model ToolFAQ {
  id       String @id @default(cuid())
  toolId   String
  question String
  answer   String @db.Text
  tool     Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model Article {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  excerpt            String   @db.Text
  content            String   @db.Text
  author             String
  readTime           String
  publishedAt        String
  relatedCategorySlug String?
  relatedToolSlugs   String[]
  createdAt          DateTime @default(now())
}
