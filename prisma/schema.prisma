datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PricingModelEnum {
  Free
  Freemium
  Paid
}

enum ReviewStateEnum {
  unverified
  verified
  needsReview
  inReview
}

enum PublishStatusEnum {
  draft
  published
  archived
}

enum MonitoringCheckStatusEnum {
  success
  failed
  timeout
  invalid_url
}

enum ReviewStatusEnum {
  pending
  approved
  rejected
  flagged
}

enum UseCaseFitTierEnum {
  primary
  strong
  partial
  listed
  exclude
}

model Category {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  iconName        String
  description     String   @db.Text
  longDescription String   @db.Text
  seoTitle        String
  seoDescription  String
  publishStatus   PublishStatusEnum @default(published)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tools Tool[]
  faqs  CategoryFAQ[]

  @@index([slug])
  @@index([publishStatus])
}

model CategoryFAQ {
  id         String   @id @default(cuid())
  categoryId String
  question   String
  answer     String   @db.Text
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Tool {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  logo              String
  tagline           String            @db.Text
  description       String            @db.Text
  categoryId        String
  pricingModel      PricingModelEnum  @default(Freemium)
  monthlyPrice      Float?
  hasFreeTrial      Boolean           @default(true)
  companyName       String?
  lastVerifiedDate  DateTime?
  verifiedBy        String?
  pricingSource     String?
  featureSource     String?
  reviewState       ReviewStateEnum?
  reviewRequestedAt DateTime?
  reviewAssignedTo  String?
  reviewNotes       String?           @db.Text
  websiteUrl        String
  affiliateUrl      String?
  affiliateEnabled  Boolean           @default(false)
  affiliateProgram  String?
  rating            Float             @default(0)
  reviewCount       Int               @default(0)
  verified          Boolean           @default(false)
  featured          Boolean           @default(false)
  trending          Boolean           @default(false)
  hasApi            Boolean           @default(false)
  hasMobileApp      Boolean           @default(false)
  hasExtension      Boolean           @default(false)
  publishStatus     PublishStatusEnum @default(published)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tags        String[]
  features    String[]
  pros        String[]
  cons        String[]
  screenshots String[]
  platforms   String[]
  targetUsers String[]

  category     Category      @relation(fields: [categoryId], references: [id])
  sources      ToolSource[]
  pricingTiers PricingTier[]
  reviews      Review[]
  faqs         ToolFAQ[]
  topForPersonas PersonaTopTool[]
  useCaseLinks   ToolUseCase[]

  alternativesFrom ToolAlternative[] @relation("AltSource")
  alternativesTo   ToolAlternative[] @relation("AltTarget")

  comparisonsAs1 Comparison[] @relation("Tool1Comparisons")
  comparisonsAs2 Comparison[] @relation("Tool2Comparisons")
  monitoringChecks ToolMonitoringCheck[]

  @@index([slug])
  @@index([categoryId])
  @@index([featured])
  @@index([trending])
  @@index([publishStatus])
}

model ToolSource {
  id         String   @id @default(cuid())
  toolId     String
  type       String
  url        String
  verifiedAt DateTime
  notes      String?
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
}

model ToolMonitoringCheck {
  id             String                    @id @default(cuid())
  toolId         String
  checkedAt      DateTime                  @default(now())
  status         MonitoringCheckStatusEnum
  httpStatus     Int?
  finalUrl       String?
  responseTimeMs Int?
  isHttps        Boolean?
  redirectCount  Int?
  errorCode      String?
  errorMessage   String?                   @db.Text
  requestedUrl   String
  createdAt      DateTime                  @default(now())

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, checkedAt(sort: Desc)])
  @@index([checkedAt])
}

model PricingTier {
  id            String   @id @default(cuid())
  toolId        String
  name          String
  price         Float?
  billingPeriod String
  features      String[]
  tool          Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
}

model ToolFAQ {
  id       String @id @default(cuid())
  toolId   String
  question String
  answer   String @db.Text
  tool     Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
}

model ToolAlternative {
  id           String @id @default(cuid())
  sourceToolId String
  targetToolId String
  sourceTool   Tool   @relation("AltSource", fields: [sourceToolId], references: [id], onDelete: Cascade)
  targetTool   Tool   @relation("AltTarget", fields: [targetToolId], references: [id], onDelete: Cascade)

  @@unique([sourceToolId, targetToolId])
  @@index([sourceToolId])
}

model Persona {
  id          String   @id @default(cuid())
  title       String   @unique
  slug        String   @unique
  iconName    String
  subtitle    String
  description String   @db.Text
  targetRole  String
  keyBenefits String[]
  publishStatus PublishStatusEnum @default(published)
  createdAt   DateTime @default(now())

  faqs     PersonaFAQ[]
  topTools PersonaTopTool[]
  useCases PersonaUseCase[]

  @@index([slug])
  @@index([publishStatus])
}

model PersonaTopTool {
  id        String  @id @default(cuid())
  personaId String
  toolId    String
  order     Int     @default(0)
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  tool      Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([personaId, toolId])
  @@index([personaId])
}

model UseCase {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  description      String            @db.Text
  primaryKeyword   String
  seoTitle         String
  seoDescription   String
  publishStatus    PublishStatusEnum @default(published)
  createdAt        DateTime          @default(now())

  personaLinks PersonaUseCase[]
  toolLinks    ToolUseCase[]

  @@index([slug])
  @@index([publishStatus])
}

model PersonaUseCase {
  id          String  @id @default(cuid())
  personaId   String
  useCaseId   String
  order       Int     @default(0)
  isPrimary   Boolean @default(false)
  pageEnabled Boolean @default(true)
  hubNote     String? @db.Text

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  useCase UseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@unique([personaId, useCaseId])
  @@index([personaId])
  @@index([useCaseId])
}

model ToolUseCase {
  id           String             @id @default(cuid())
  toolId       String
  useCaseId    String
  fitTier      UseCaseFitTierEnum
  capabilities String             @db.Text
  limitation   String?            @db.Text
  evidenceUrl  String
  verifiedAt   DateTime
  displayOrder Int                @default(0)
  section      String             @default("")

  tool    Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  useCase UseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@unique([toolId, useCaseId, section])
  @@index([useCaseId])
  @@index([toolId])
}

model PersonaFAQ {
  id        String  @id @default(cuid())
  personaId String
  question  String
  answer    String  @db.Text
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId])
}

model Review {
  id              String           @id @default(cuid())
  toolId          String
  authorName      String
  authorRole      String           @default("")
  rating          Int
  comment         String           @db.Text
  email           String?
  status          ReviewStatusEnum @default(pending)
  date            DateTime
  verifiedUser    Boolean          @default(false)
  moderatedAt     DateTime?
  moderatedBy     String?
  moderationNotes String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
  @@index([status])
  @@index([toolId, status])
}

model Comparison {
  id         String   @id @default(cuid())
  slug       String   @unique
  tool1Id    String
  tool2Id    String
  title      String
  overview   String   @db.Text
  bestFor1   String   @db.Text
  bestFor2   String   @db.Text
  verdict    String   @db.Text
  winnerSlug String
  publishStatus PublishStatusEnum @default(published)
  createdAt  DateTime @default(now())

  tool1    Tool                @relation("Tool1Comparisons", fields: [tool1Id], references: [id])
  tool2    Tool                @relation("Tool2Comparisons", fields: [tool2Id], references: [id])
  features ComparisonFeature[]

  @@index([slug])
  @@index([publishStatus])
}

model ComparisonFeature {
  id           String     @id @default(cuid())
  comparisonId String
  feature      String
  tool1Value   String
  tool2Value   String
  winnerSlug   String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId])
}

model Article {
  id                  String   @id @default(cuid())
  title               String
  slug                String   @unique
  excerpt             String   @db.Text
  content             String   @db.Text
  author              String
  readTime            String
  publishedAt         DateTime
  relatedCategorySlug String?
  relatedToolSlugs    String[]
  publishStatus       PublishStatusEnum @default(published)
  createdAt           DateTime @default(now())

  @@index([slug])
  @@index([publishStatus])
}