datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PricingModelEnum {
  Free
  Freemium
  Paid
}

enum ReviewStateEnum {
  unverified
  verified
  needsReview
  inReview
}

model Category {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  iconName        String
  description     String   @db.Text
  longDescription String   @db.Text
  seoTitle        String
  seoDescription  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tools Tool[]
  faqs  CategoryFAQ[]

  @@index([slug])
}

model CategoryFAQ {
  id         String   @id @default(cuid())
  categoryId String
  question   String
  answer     String   @db.Text
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Tool {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  logo              String
  tagline           String            @db.Text
  description       String            @db.Text
  categoryId        String
  pricingModel      PricingModelEnum  @default(Freemium)
  monthlyPrice      Float?
  hasFreeTrial      Boolean           @default(true)
  companyName       String?
  lastVerifiedDate  DateTime?
  verifiedBy        String?
  pricingSource     String?
  featureSource     String?
  reviewState       ReviewStateEnum?
  reviewRequestedAt DateTime?
  reviewAssignedTo  String?
  reviewNotes       String?           @db.Text
  websiteUrl        String
  rating            Float             @default(0)
  reviewCount       Int               @default(0)
  verified          Boolean           @default(false)
  featured          Boolean           @default(false)
  trending          Boolean           @default(false)
  hasApi            Boolean           @default(false)
  hasMobileApp      Boolean           @default(false)
  hasExtension      Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tags        String[]
  features    String[]
  pros        String[]
  cons        String[]
  screenshots String[]
  platforms   String[]
  targetUsers String[]

  category     Category      @relation(fields: [categoryId], references: [id])
  sources      ToolSource[]
  pricingTiers PricingTier[]
  reviews      Review[]
  faqs         ToolFAQ[]
  topForPersonas PersonaTopTool[]

  alternativesFrom ToolAlternative[] @relation("AltSource")
  alternativesTo   ToolAlternative[] @relation("AltTarget")

  comparisonsAs1 Comparison[] @relation("Tool1Comparisons")
  comparisonsAs2 Comparison[] @relation("Tool2Comparisons")

  @@index([slug])
  @@index([categoryId])
}

model ToolSource {
  id         String   @id @default(cuid())
  toolId     String
  type       String
  url        String
  verifiedAt DateTime
  notes      String?
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
}

model PricingTier {
  id            String   @id @default(cuid())
  toolId        String
  name          String
  price         Float?
  billingPeriod String
  features      String[]
  tool          Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
}

model ToolFAQ {
  id       String @id @default(cuid())
  toolId   String
  question String
  answer   String @db.Text
  tool     Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
}

model ToolAlternative {
  id           String @id @default(cuid())
  sourceToolId String
  targetToolId String
  sourceTool   Tool   @relation("AltSource", fields: [sourceToolId], references: [id], onDelete: Cascade)
  targetTool   Tool   @relation("AltTarget", fields: [targetToolId], references: [id], onDelete: Cascade)

  @@unique([sourceToolId, targetToolId])
  @@index([sourceToolId])
}

model Persona {
  id          String   @id @default(cuid())
  title       String   @unique
  slug        String   @unique
  iconName    String
  subtitle    String
  description String   @db.Text
  targetRole  String
  keyBenefits String[]
  createdAt   DateTime @default(now())

  faqs     PersonaFAQ[]
  topTools PersonaTopTool[]

  @@index([slug])
}

model PersonaTopTool {
  id        String  @id @default(cuid())
  personaId String
  toolId    String
  order     Int     @default(0)
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  tool      Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([personaId, toolId])
  @@index([personaId])
}

model PersonaFAQ {
  id        String  @id @default(cuid())
  personaId String
  question  String
  answer    String  @db.Text
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId])
}

model Review {
  id           String   @id @default(cuid())
  toolId       String
  authorName   String
  authorRole   String
  rating       Int
  comment      String   @db.Text
  date         DateTime
  verifiedUser Boolean  @default(false)
  createdAt    DateTime @default(now())

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
}

model Comparison {
  id         String   @id @default(cuid())
  slug       String   @unique
  tool1Id    String
  tool2Id    String
  title      String
  overview   String   @db.Text
  bestFor1   String   @db.Text
  bestFor2   String   @db.Text
  verdict    String   @db.Text
  winnerSlug String
  createdAt  DateTime @default(now())

  tool1    Tool                @relation("Tool1Comparisons", fields: [tool1Id], references: [id])
  tool2    Tool                @relation("Tool2Comparisons", fields: [tool2Id], references: [id])
  features ComparisonFeature[]

  @@index([slug])
}

model ComparisonFeature {
  id           String     @id @default(cuid())
  comparisonId String
  feature      String
  tool1Value   String
  tool2Value   String
  winnerSlug   String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId])
}

model Article {
  id                  String   @id @default(cuid())
  title               String
  slug                String   @unique
  excerpt             String   @db.Text
  content             String   @db.Text
  author              String
  readTime            String
  publishedAt         DateTime
  relatedCategorySlug String?
  relatedToolSlugs    String[]
  createdAt           DateTime @default(now())

  @@index([slug])
}